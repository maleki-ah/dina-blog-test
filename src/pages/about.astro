---
import { site } from '@config/site';
import Base from '@layouts/Base.astro';
import { getAuthors, getBoolField, getTitle, getVenue, getYear, parseBibtex } from '@utils/bibtex';
import { getCollection, render } from 'astro:content';

import AboutContent from '../data/about.mdx';
import bibRaw from '../data/papers.bib?raw';

// Announcements
const allAnnouncements = site.announcements.enabled
  ? (await getCollection('announcements'))
      .filter((e) => !e.data.hidden)
      .sort((a, b) => {
        if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
        return b.data.date.getTime() - a.data.date.getTime();
      })
      .slice(0, site.announcements.limit)
  : [];

// Latest posts
const allPosts = site.latestPosts.enabled
  ? (await getCollection('posts'))
      .filter((p) => !p.data.hidden)
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
      .slice(0, site.latestPosts.limit)
  : [];

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Selected publications
const selectedPapers = site.selectedPapers.enabled
  ? parseBibtex(bibRaw).filter((e) => getBoolField(e, 'selected'))
  : [];

// Pre-render announcement content
const renderedAnnouncements = await Promise.all(
  allAnnouncements.map(async (item) => ({ item, rendered: await render(item) })),
);

// Hero stats (build-time totals)
const statPosts = (await getCollection('posts')).filter((p) => !p.data.hidden).length;
const statMembers = (await getCollection('people')).length;
const statTalks = (await getCollection('announcements')).filter((e) => !e.data.hidden).length;
---

<Base>
  <div class="post page-container py-8">
    <!-- Lab hero: glass manifesto panel -->
    <section class="lab-hero">
      <img
        class="lab-hero-logo"
        src={`${site.base}/assets/logo/DINA-logo.png`}
        alt="DINA Lab logo"
        width="168"
        height="168"
        loading="eager"
        fetchpriority="high"
      />
      <div class="lab-hero-body">
        <p class="lab-eyebrow">Distributed Systems · AI · Cloud</p>
        <h1
          class="post-title lab-title"
          style="font-family: var(--font-sans); color: var(--global-text-color);"
          data-i18n="brandName"
        >
          {(site.title as string) === 'blank' ? site.author.name : site.title}
        </h1>
        {
          site.author.subtitle && (
            <p
              class="desc"
              style="color: var(--global-text-color-light);"
              set:html={site.author.subtitle}
            />
          )
        }
        <div class="prose lab-bio max-w-none">
          <AboutContent />
        </div>
        <div class="lab-stats">
          <div class="lab-stat">
            <strong data-i18n-num={String(statPosts)}>{statPosts}</strong>
            <span data-i18n="statPosts">Posts</span>
          </div>
          <div class="lab-stat">
            <strong data-i18n-num={String(statMembers)}>{statMembers}</strong>
            <span data-i18n="statMembers">Members</span>
          </div>
          <div class="lab-stat">
            <strong data-i18n-num={String(statTalks)}>{statTalks}</strong>
            <span data-i18n="statTalks">Talks</span>
          </div>
        </div>
      </div>
    </section>

    <article>
      <!-- Announcements / News -->
      {
        site.announcements.enabled && allAnnouncements.length > 0 && (
          <section class="mt-8">
            <h2 style="color: var(--global-text-color); border-bottom: 1px solid var(--global-divider-color); padding-bottom: 0.3rem;">
              <a href={`${site.base}/news/`} style="color: inherit; text-decoration: none;">
                <span data-i18n="newsTitle">news</span>
              </a>
            </h2>
            <div class={site.announcements.scrollable ? 'scrollable-list' : ''}>
              <table style="width: 100%; border-collapse: collapse;">
                <tbody>
                  {renderedAnnouncements.map(({ item, rendered: { Content } }) => (
                    <tr style="border-bottom: 1px solid var(--global-divider-color);">
                      <td style="padding: 0.5rem 0; padding-inline-end: 1rem; white-space: nowrap; vertical-align: top; color: var(--global-text-color-light); font-size: 0.8rem;">
                        <time data-i18n-date-short={item.data.date.toISOString()}>
                          {formatDate(item.data.date)}
                        </time>
                      </td>
                      <td style="padding: 0.5rem 0; font-size: 0.9rem; color: var(--global-text-color);">
                        <Content />
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )
      }

      <!-- Latest posts -->
      {
        site.latestPosts.enabled && allPosts.length > 0 && (
          <section class="mt-8">
            <h2 style="color: var(--global-text-color); border-bottom: 1px solid var(--global-divider-color); padding-bottom: 0.3rem;">
              <a href={`${site.base}/`} style="color: inherit; text-decoration: none;">
                <span data-i18n="latestPosts">latest posts</span>
              </a>
            </h2>
            <div class={site.latestPosts.scrollable ? 'scrollable-list' : ''}>
              <table style="width: 100%; border-collapse: collapse;">
                <tbody>
                  {allPosts.map((post) => (
                    <tr style="border-bottom: 1px solid var(--global-divider-color);">
                      <td style="padding: 0.5rem 0; padding-inline-end: 1rem; white-space: nowrap; vertical-align: top; color: var(--global-text-color-light); font-size: 0.8rem;">
                        <time data-i18n-date-short={post.data.date.toISOString()}>
                          {formatDate(post.data.date)}
                        </time>
                      </td>
                      <td style="padding: 0.5rem 0; font-size: 0.9rem;">
                        <a
                          href={`${site.base}/posts/${post.id}/`}
                          style="color: var(--global-theme-color); text-decoration: none;"
                        >
                          {post.data.title}
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )
      }

      <!-- Selected publications -->
      {
        site.selectedPapers.enabled && selectedPapers.length > 0 && (
          <section class="mt-8">
            <h2 style="color: var(--global-text-color); border-bottom: 1px solid var(--global-divider-color); padding-bottom: 0.3rem; margin-bottom: 0.3rem;">
              <a href={`${site.base}/publications/`} style="color: inherit; text-decoration: none;">
                <span data-i18n="selectedPubs">selected publications</span>
              </a>
            </h2>
            <ol class="m-0 list-none p-0">
              {selectedPapers.map((entry) => {
                const title = getTitle(entry);
                const authors = getAuthors(entry);
                const venue = getVenue(entry);
                const year = getYear(entry);
                const abbr = entry.fields.abbr;
                const url =
                  entry.fields.html ??
                  (entry.fields.doi ? `https://doi.org/${entry.fields.doi}` : '');
                const award = entry.fields.award;
                return (
                  <li class="mb-4 text-sm" style="line-height: 1.6;">
                    {abbr && <span class="badge-abbr mr-2">{abbr}</span>}
                    {url ? (
                      <a
                        href={url}
                        target="_blank"
                        rel="noopener noreferrer"
                        style="color: var(--global-text-color); font-weight: 600; text-decoration: none;"
                      >
                        {title}
                      </a>
                    ) : (
                      <strong style="color: var(--global-text-color);">{title}</strong>
                    )}
                    <br />
                    <span style="color: var(--global-text-color-light);">{authors}</span>
                    {(venue || year) && (
                      <>
                        {' · '}
                        <em style="color: var(--global-text-color-light);">
                          {venue}
                          {venue && year ? ', ' : ''}
                          {year || ''}
                        </em>
                      </>
                    )}
                    {award && (
                      <span class="badge-abbr ml-2" style="background-color: #f59e0b;">
                        {entry.fields.award_name ?? '🏆'}
                      </span>
                    )}
                  </li>
                );
              })}
            </ol>
            <p class="mt-2 text-sm">
              <a
                href={`${site.base}/publications/`}
                style="color: var(--global-theme-color); text-decoration: none;"
                data-i18n="fullPubList"
              >
                Full publication list
              </a>{' '}
              <span class="back-arrow" aria-hidden="true">
                &rarr;
              </span>
            </p>
          </section>
        )
      }
    </article>
  </div>
</Base>

<style>
  .clearfix::after {
    content: '';
    display: table;
    clear: both;
  }
  .post-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }
  .desc {
    font-size: 1rem;
    margin-bottom: 1rem;
  }
</style>
